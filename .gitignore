runs-local/
dist/
.env
sandbox/.env
*.kicad_prl
.DS_Store
# Runs: only the summary side is committed; the full run folders go into the release archives (tools/pack.sh).
runs/*/*
!runs/*/SUMMARY.md
!runs/*/brief.md
!runs/*/report.json
!runs/*/img.tracks.png
!runs/*/img.before.png
!runs/*/img.all.png
!runs/*/img.In*.png
!runs/*/work/
runs/*/work/*
!runs/*/work/NOTES.md
!runs/*/work/BT-REVIEW.md
!runs/*/work/progress/
runs/*/work/progress/*
!runs/*/work/progress/*.md
!runs/*/ask/
runs/*/ask/*
!runs/*/ask/ANSWER.md
sandbox/.codex-auth.json
sandbox/codex-login/
# Cross-model study: the same split (tools/xm-index.cjs writes the review summaries and cross-model/INDEX.md).
cross-model/*/*/*
!cross-model/*/*/SUMMARY.md
!cross-model/*/*/brief.md
!cross-model/*/*/report.json
!cross-model/*/*/img.tracks.png
!cross-model/*/*/REVIEW.md
!cross-model/*/*/review.json
!cross-model/*/*/key.json
!cross-model/*/*/work/
cross-model/*/*/work/*
!cross-model/*/*/work/NOTES.md
!cross-model/*/*/work/BT-REVIEW.md
!cross-model/*/*/work/progress/
cross-model/*/*/work/progress/*
!cross-model/*/*/work/progress/*.md
